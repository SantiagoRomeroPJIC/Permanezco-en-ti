---
import SectionTitle from "./SectionTitle.astro";
---

<section class="py-24">
    <div
        class="overflow-hidden rounded-[2rem] bg-gradient-to-br from-green-900 to-green-700 p-10 shadow-2xl md:p-16"
    >
        <SectionTitle
            title="Foro participativo"
            subtitle="Espacio de diálogo, apoyo y construcción colectiva para la comunidad estudiantil."
            light={true}
        />

        <div class="mt-16 grid gap-8 md:grid-cols-3">
            <!-- card -->
            <div
                class="rounded-3xl border border-white/10 bg-white/10 p-8 backdrop-blur"
            >
                <div
                    class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/20 text-3xl"
                >
                    💬
                </div>

                <h3 class="mt-6 text-2xl font-bold text-white">
                    Ideas y propuestas
                </h3>

                <p class="mt-4 leading-relaxed text-green-50">
                    Comparte iniciativas y opiniones que ayuden a fortalecer la
                    permanencia y el bienestar universitario.
                </p>
            </div>

            <!-- card -->
            <div
                class="rounded-3xl border border-white/10 bg-white/10 p-8 backdrop-blur"
            >
                <div
                    class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/20 text-3xl"
                >
                    📚
                </div>

                <h3 class="mt-6 text-2xl font-bold text-white">
                    Apoyo académico
                </h3>

                <p class="mt-4 leading-relaxed text-green-50">
                    Encuentra recursos, estrategias y espacios colaborativos
                    para fortalecer tu proceso académico.
                </p>
            </div>

            <!-- card -->
            <div
                class="rounded-3xl border border-white/10 bg-white/10 p-8 backdrop-blur"
            >
                <div
                    class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/20 text-3xl"
                >
                    🤝
                </div>

                <h3 class="mt-6 text-2xl font-bold text-white">
                    Comunidad estudiantil
                </h3>

                <p class="mt-4 leading-relaxed text-green-50">
                    Construimos espacios de participación, escucha y
                    acompañamiento entre estudiantes.
                </p>
            </div>
        </div>

        <!-- CTA -->
        <div class="mt-14 flex justify-center gap-6">
            <a
                href="/comunidad"
                class="rounded-2xl border border-white/40 px-8 py-4 font-semibold text-white transition hover:bg-white hover:text-green-950"
            >
                Ver comunidad
            </a>

            <a
                href="https://docs.google.com/forms/d/e/1FAIpQLSdmJiDKrfMefGV2g1ixJShOGv4002hC2P80fiT4TigpO9mVqw/viewform?usp=header"
                target="_blank"
                class="rounded-2xl bg-white px-8 py-4 font-semibold text-green-900 transition hover:scale-105"
            >
                Participar en el programa
            </a>
        </div>
    </div>
</section>
