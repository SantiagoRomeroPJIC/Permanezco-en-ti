---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="mb-16 text-center">

  <!-- etiqueta superior -->
  <div class="mb-4 flex items-center justify-center gap-3">

    <div class="h-[2px] w-12 rounded-full bg-yellow-400"></div>

    <span class="text-sm font-semibold uppercase tracking-[0.3em] text-green-700">
      Permanezco en Ti
    </span>

    <div class="h-[2px] w-12 rounded-full bg-yellow-400"></div>

  </div>

  <!-- titulo -->
  <h2
    class="mx-auto max-w-4xl text-4xl font-extrabold leading-tight text-green-950 md:text-5xl"
  >
    {title}
  </h2>

  <!-- subtitulo -->
  {
    subtitle && (
      <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-gray-600">
        {subtitle}
      </p>
    )
  }

</div>
</div>