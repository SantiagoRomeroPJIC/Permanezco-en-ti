---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Permanezco en ti: Permanencia y retención con calidad académica y humana">

  <section class="flex min-h-[70vh] items-center">

    <div class="max-w-3xl space-y-8">

      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-green-700">
        Permanezco en ti
      </p>

      <h1 class="text-5xl font-bold leading-tight md:text-7xl">
        Acompañamiento,
        aprendizaje y
        cercania.
      </h1>

      <p class="max-w-2xl text-lg leading-relaxed text-gray-600">
        Tu permanencia, nuestro compromiso,
		Espacio académico enfocado en el aprendizaje,
        asesorías y talleres para estudiantes.
      </p>

      <div class="flex gap-4">

        <a
          href="/asesorias"
          class="rounded-lg bg-green-900 px-6 py-3 text-white transition hover:bg-green-800"
        >
          Agendar asesoría
        </a>

        <a
          href="/novedades"
          class="rounded-lg border border-gray-300 px-6 py-3 transition hover:border-green-900 hover:text-green-900"
        >
          Ver novedades
        </a>

      </div>

    </div>

  </section>

</MainLayout>