---
import SectionTitle from "../components/SectionTitle.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>

  <section class="mx-auto max-w-[1400px] px-4 py-16 md:px-6 md:py-20">

    <div class="grid items-stretch gap-8 xl:grid-cols-2">

      <!-- Imagen tipo hero -->

      <div
        class="relative min-h-[320px] overflow-hidden rounded-3xl shadow-2xl md:min-h-[420px]"
      >

        <img
          src="/images/Cooperacion.jpg"
          alt="Estudiantes"
          class="h-full w-full object-cover"
        />

        <!-- Overlay -->

        <div class="absolute inset-0 bg-gradient-to-t from-green-950/90 to-green-900/30"></div>

        <!-- Texto dentro de imagen -->

        <div class="absolute bottom-0 left-0 w-full p-6 text-white md:p-8">

          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-yellow-300 md:text-sm">
            Comunidad estudiantil
          </p>

          <h3 class="mt-3 max-w-md text-2xl font-bold leading-tight md:text-4xl">
            Acompañamiento
            y permanencia.
          </h3>

        </div>

      </div>

      <!-- Card -->

      <div
        class="flex flex-col justify-center rounded-3xl border border-white/20 bg-white/80 p-6 shadow-2xl backdrop-blur md:p-10"
      >

        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-green-700 md:text-sm">
          Permanezco en Ti
        </p>

        <h3 class="mt-4 text-3xl font-bold leading-tight text-green-950 md:text-5xl">
          Calidad académica y humana.
        </h3>

        <p class="mt-6 text-base leading-relaxed text-gray-600 md:text-lg">
          El programa impulsa espacios de acompañamiento,
          bienestar y fortalecimiento académico para los
          estudiantes del Politécnico Colombiano Jaime
          Isaza Cadavid.
        </p>

        <p class="mt-4 text-base leading-relaxed text-gray-600 md:text-lg">
          A través de asesorías, actividades y recursos,
          se busca construir una experiencia universitaria
          más cercana, participativa y humana.
        </p>

        <!-- Botones -->

        <div class="mt-8 flex flex-col gap-4 sm:flex-row">

          <a
            href="/novedades"
            class="rounded-xl bg-green-900 px-6 py-3 text-center font-semibold text-white transition hover:bg-green-800"
          >
            Ver novedades
          </a>

          <a
            href="/asesorias"
            class="rounded-xl border border-green-900 px-6 py-3 text-center font-semibold text-green-900 transition hover:bg-green-900 hover:text-white"
          >
            Asesorías
          </a>

        </div>

      </div>

    </div>

  </section>

</MainLayout>