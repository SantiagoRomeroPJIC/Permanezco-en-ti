---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Asesorías">

  <section class="space-y-6">

    <h1 class="text-4xl font-bold">
      Agendar asesoría
    </h1>

    <p class="max-w-2xl text-gray-600">
      Completa el siguiente formulario para solicitar una asesoría.
    </p>

    <iframe
      src="https://calendar.app.google/mSXhneWdqvFAuj7U6"
      width="100%"
      height="900"
      class="rounded-xl border border-gray-200"
    >
    </iframe>

  </section>

</MainLayout>