---
import MainLayout from "../layouts/MainLayout.astro";
import { getCollection } from "astro:content";

const novedades = await getCollection("novedades");
---

<MainLayout title="Novedades">

  <section class="space-y-8">

    <div>
      <h1 class="text-4xl font-bold">
        Novedades
      </h1>

      <p class="text-gray-600">
        Actividades y novedades de Permanezco en Ti.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2">

      {
        novedades.map((novedad: any) => (

          <a
            href={`/novedades/${novedad.id}`}
            class="overflow-hidden rounded-2xl border border-gray-200 bg-white transition hover:border-green-700 hover:shadow-lg"
          >

            <img
              src={novedad.data.image}
              alt={novedad.data.title}
              class="h-44 w-full object-contain"
            />

            <div class="p-6">

              <p class="text-sm text-green-700">
                {novedad.data.date.toLocaleDateString()}
              </p>

              <h2 class="mt-2 text-2xl font-semibold">
                {novedad.data.title}
              </h2>

              <p class="mt-3 text-gray-600">
                {novedad.data.description}
              </p>

            </div>

          </a>

        ))
      }

    </div>

  </section>

</MainLayout>