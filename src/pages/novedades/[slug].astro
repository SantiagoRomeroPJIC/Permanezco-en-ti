---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {

  const novedades = await getCollection("novedades");

  return novedades.map((novedad: any) => ({
    params: {
      slug: novedad.id,
    },

    props: {
      novedad,
    },
  }));
}

const { novedad } = Astro.props as any;

const { Content } = await render(novedad);
---

<MainLayout title={novedad.data.title}>

  <article class="mx-auto max-w-4xl space-y-8">

    <img
      src={novedad.data.image}
      alt={novedad.data.title}
      class="h-[400px] w-full rounded-2xl object-contain"
    />

    <div class="space-y-4">

      <p class="text-sm text-green-700">
        {novedad.data.date.toLocaleDateString()}
      </p>

      <h1 class="text-5xl font-bold leading-tight">
        {novedad.data.title}
      </h1>

      <p class="text-xl text-gray-600">
        {novedad.data.description}
      </p>

    </div>

    <div class="prose prose-lg max-w-none">
      <Content />
    </div>

  </article>

</MainLayout>