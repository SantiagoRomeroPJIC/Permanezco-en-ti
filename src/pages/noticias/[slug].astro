---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {

  const noticias = await getCollection("noticias");

  return noticias.map((noticia: any) => ({
    params: {
      slug: noticia.id,
    },

    props: {
      noticia,
    },
  }));
}

const { noticia } = Astro.props as any;

const { Content } = await render(noticia);
---

<MainLayout title={noticia.data.title}>

  <article class="max-w-3xl space-y-6">

    <p class="text-sm text-green-700">
      {noticia.data.date.toLocaleDateString()}
    </p>

    <h1 class="text-5xl font-bold">
      {noticia.data.title}
    </h1>

    <div class="prose prose-lg max-w-none">
      <Content />
    </div>

  </article>

</MainLayout>