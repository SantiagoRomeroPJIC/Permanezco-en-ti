---
import MainLayout from "../layouts/MainLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<MainLayout title="Galería">

  <section class="space-y-20 py-20">

    <!-- Título -->

    <SectionTitle
      title="Galería institucional"
      subtitle="Momentos, encuentros y experiencias del programa Permanezco en Ti."
    />

    <!-- Imágenes -->

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">

      <img
        src="/images/talleres1.jpg"
        alt="Encuentro estudiantil"
        class="h-80 w-full rounded-3xl object-cover shadow-xl transition hover:scale-[1.02]"
      />

      <img
        src="/images/talleres2.png"
        alt="Taller académico"
        class="h-80 w-full rounded-3xl object-cover shadow-xl transition hover:scale-[1.02]"
      />

      <img
        src="/images/talleres3.jpg"
        alt="Actividad institucional"
        class="h-80 w-full rounded-3xl object-cover shadow-xl transition hover:scale-[1.02]"
      />

    </div>

    <!-- Videos -->

    <div class="space-y-8">

      <div>
        <h2 class="text-4xl font-bold text-green-950">
          Videos y encuentros
        </h2>

        <p class="mt-3 text-lg text-gray-600">
          Conversatorios, talleres y espacios de acompañamiento estudiantil.
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-2">

        <iframe
          class="h-[350px] w-full rounded-3xl shadow-xl"
          src="https://youtu.be/Rb_Ksr4Dywk"
          title="Video institucional"
          allowfullscreen
        ></iframe>

        <iframe
          class="h-[350px] w-full rounded-3xl shadow-xl"
          src=""
          title="Encuentro estudiantil"
          allowfullscreen
        ></iframe>

      </div>

    </div>

  </section>

</MainLayout>